# ============================================
# AgriGuard Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to GitHub!

# Server Settings
PORT=5000
NODE_ENV=development

# Database Configuration
# Using SQLite (local development) - no setup needed
# For production with PostgreSQL, set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/agriguard

# Application Settings
APP_NAME=AgriGuard
APP_VERSION=1.0.0
LOG_LEVEL=info

# Optional: Email Configuration (future feature)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Optional: API Keys (future feature)
# API_KEY=your_secret_api_key
# SECRET_TOKEN=your_secret_token

# Optional: External Services
# WEATHER_API_KEY=your_weather_api_key
# SMS_API_KEY=your_sms_api_key
